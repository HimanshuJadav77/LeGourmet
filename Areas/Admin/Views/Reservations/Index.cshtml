@model IEnumerable<Restaurant_Management.Models.Entities.TableReservation>
@{
    ViewData["Title"] = "Manage Table Bookings";
    var selectedDate = ViewBag.SelectedDate as string;
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-extrabold text-dark mb-1">Table Pre-Bookings & Floor Seating</h2>
        <p class="text-secondary small mb-0">Manage customer table reservations, guest party sizes, and seating status transitions</p>
    </div>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-calendar"></i></span>
                <input type="date" name="date" class="form-control bg-light" value="@selectedDate" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm bg-light">
                <option value="All">-- All Booking Statuses --</option>
                <option value="Confirmed" selected="@(currentStatus == "Confirmed")">Confirmed</option>
                <option value="Seated" selected="@(currentStatus == "Seated")">Seated</option>
                <option value="Completed" selected="@(currentStatus == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3 text-end">
            <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-2">Reset</a>
        </div>
    </form>
</div>

<!-- Reservations Table -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th>Ref #</th>
                    <th>Date & Time</th>
                    <th>Table</th>
                    <th>Customer Contact</th>
                    <th>Party</th>
                    <th>Special Requests</th>
                    <th>Status</th>
                    <th class="text-end">Manage Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2 text-muted"></i>
                            No table bookings found matching criteria.
                        </td>
                    </tr>
                }
                @foreach (var res in Model)
                {
                    <tr>
                        <td class="fw-bold text-dark">#RES-@res.ReservationId.ToString("D5")</td>
                        <td>
                            <div class="fw-semibold text-dark">@res.ReservationDate.ToString("dd MMM yyyy")</div>
                            <small class="text-secondary"><i class="bi bi-clock me-1"></i> @res.TimeSlot</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                Table @(res.Table?.TableNumber ?? "T-Pending")
                            </span>
                            <small class="text-secondary d-block">@(res.Table?.Location ?? "Main Floor")</small>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark small">@res.CustomerName</div>
                            <small class="text-secondary d-block">@res.CustomerPhone</small>
                            <small class="text-secondary d-block">@res.CustomerEmail</small>
                        </td>
                        <td class="fw-bold text-dark">
                            <i class="bi bi-people me-1 text-secondary"></i> @res.GuestCount
                        </td>
                        <td class="small text-secondary" style="max-width: 200px;">
                            @(string.IsNullOrEmpty(res.SpecialRequests) ? "None" : res.SpecialRequests)
                        </td>
                        <td>
                            <status-badge status="@res.Status"></status-badge>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                @if (res.Status == "Confirmed")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reservationId" value="@res.ReservationId" />
                                        <input type="hidden" name="newStatus" value="Seated" />
                                        <button type="submit" class="btn btn-primary" title="Seat Party">
                                            <i class="bi bi-check-circle me-1"></i> Seat
                                        </button>
                                    </form>
                                }
                                else if (res.Status == "Seated")
                                {
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reservationId" value="@res.ReservationId" />
                                        <input type="hidden" name="newStatus" value="Completed" />
                                        <button type="submit" class="btn btn-success" title="Mark Completed">
                                            <i class="bi bi-patch-check me-1"></i> Complete
                                        </button>
                                    </form>
                                }
                                @if (res.Status != "Cancelled" && res.Status != "Completed")
                                {
                                    <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('Cancel this reservation?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reservationId" value="@res.ReservationId" />
                                        <input type="hidden" name="newStatus" value="Cancelled" />
                                        <button type="submit" class="btn btn-outline-danger" title="Cancel Booking">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
