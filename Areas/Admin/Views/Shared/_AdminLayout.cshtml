<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin & POS Console</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Chart.js for Dynamic LINQ Demand Reports -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-light">
    <!-- Admin Top Header -->
    <header class="navbar navbar-dark sticky-top bg-dark flex-md-nowrap p-2 shadow-sm border-bottom border-secondary">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 fs-6 d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <span class="p-1 rounded bg-warning text-dark"><i class="bi bi-speedometer2"></i></span>
            <span class="fw-bold text-white">Le<span class="text-warning">Gourmet</span> POS</span>
        </a>
        <button class="navbar-toggler position-absolute d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="w-100 px-3 d-none d-md-block text-secondary small">
            <span class="badge bg-danger me-2">ADMIN CONSOLE</span> Live Restaurant Management & Point of Sale System
        </div>
        <div class="navbar-nav flex-row px-3 gap-2 align-items-center">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill px-3" target="_blank" title="View Customer Website">
                <i class="bi bi-box-arrow-up-right me-1"></i> Customer View
            </a>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar Navigation -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block admin-sidebar collapse px-3 py-4">
                <div class="position-sticky pt-1">
                    <div class="text-uppercase text-secondary fw-bold fs-7 mb-2 px-3">Core Operations</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-grid-1x2-fill"></i> Overview Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Orders" ? "active" : "")" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                                <i class="bi bi-receipt-cutoff"></i> POS Live Orders
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reservations" ? "active" : "")" asp-area="Admin" asp-controller="Reservations" asp-action="Index">
                                <i class="bi bi-calendar-event"></i> Table Bookings
                            </a>
                        </li>
                    </ul>

                    <div class="text-uppercase text-secondary fw-bold fs-7 mb-2 px-3">Analytics & Intelligence</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart-line-fill text-warning"></i> Demand Reports (LINQ)
                            </a>
                        </li>
                    </ul>

                    <div class="text-uppercase text-secondary fw-bold fs-7 mb-2 px-3">Catalog & Floor Setup</div>
                    <ul class="nav flex-column mb-3">
                        <li class="nav-item">
                            <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MenuItems" ? "active" : "")" asp-area="Admin" asp-controller="MenuItems" asp-action="Index">
                                <i class="bi bi-card-checklist"></i> Food Menu Items
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="admin-nav-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tables" ? "active" : "")" asp-area="Admin" asp-controller="Tables" asp-action="Index">
                                <i class="bi bi-layout-wtf"></i> Dining Tables & Layout
                            </a>
                        </li>
                    </ul>

                    <hr class="border-secondary my-3" />
                    <div class="px-3 py-2 rounded-3 bg-black border border-secondary text-secondary small">
                        <div class="text-white fw-bold"><i class="bi bi-person-badge text-warning me-1"></i> Admin Session</div>
                        <div>@User.Identity?.Name</div>
                        <div class="text-success small"><i class="bi bi-circle-fill fs-8"></i> Live Connected</div>
                    </div>
                </div>
            </nav>

            <!-- Main Content Area -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                        <div class="fw-medium">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                        <div class="fw-medium">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/restaurant.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
