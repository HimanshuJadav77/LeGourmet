@model IEnumerable<Restaurant_Management.Models.Entities.MenuItem>
@{
    ViewData["Title"] = "Manage Menu Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-extrabold text-dark mb-1">Food Menu Catalog (CRUD)</h2>
        <p class="text-secondary small mb-0">Create, Read, Update, and Delete food dishes and beverage offerings</p>
    </div>
    <a asp-action="Create" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Dish
    </a>
</div>

<!-- Filter & Search Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control bg-light" placeholder="Search dishes by name or description..." value="@ViewBag.CurrentSearch" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select form-select-sm bg-light" asp-items="ViewBag.Categories">
                <option value="">-- All Categories --</option>
            </select>
        </div>
        <div class="col-md-3 text-end">
            <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Apply Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-2">Reset</a>
        </div>
    </form>
</div>

<!-- Menu Items Table -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th>Dish</th>
                    <th>Category</th>
                    <th class="text-center">Dietary</th>
                    <th class="text-center">Price</th>
                    <th class="text-center">Prep Time</th>
                    <th class="text-center">Availability</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=100&q=80" : item.ImageUrl)" 
                                     alt="@item.Name" 
                                     class="rounded-3 object-fit-cover" 
                                     style="width: 48px; height: 48px;" />
                                <div>
                                    <h6 class="fw-bold mb-0 text-dark">@item.Name</h6>
                                    <small class="text-secondary text-truncate d-block" style="max-width: 220px;">@item.Description</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-light text-dark border">@item.Category?.Name</span></td>
                        <td class="text-center">@Html.VegNonVegBadge(item.IsVegetarian)</td>
                        <td class="text-center fw-bold text-dark">@Html.FormatCurrency(item.Price)</td>
                        <td class="text-center text-secondary small"><i class="bi bi-clock me-1"></i> @item.PreparationTimeMinutes m</td>
                        <td class="text-center">
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Sold Out</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@item.MenuItemId" class="btn btn-outline-dark" title="Edit Dish">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.MenuItemId" class="btn btn-outline-danger" title="Delete Dish">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
