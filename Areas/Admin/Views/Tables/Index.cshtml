@model IEnumerable<Restaurant_Management.Models.Entities.DiningTable>
@{
    ViewData["Title"] = "Manage Dining Tables";
    var locations = ViewBag.Locations as List<string> ?? new List<string>();
    var currentLocation = ViewBag.CurrentLocation as string ?? "All";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-extrabold text-dark mb-1">Dining Floor & Tables (CRUD)</h2>
        <p class="text-secondary small mb-0">Manage table layout, capacity, dining sections, and availability statuses</p>
    </div>
    <a asp-action="Create" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Add New Table
    </a>
</div>

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-md-5">
            <select name="location" class="form-select form-select-sm bg-light">
                <option value="All">-- All Floor Locations --</option>
                @foreach (var loc in locations)
                {
                    <option value="@loc" selected="@(currentLocation == loc)">@loc</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select form-select-sm bg-light">
                <option value="All">-- All Statuses --</option>
                <option value="Available" selected="@(currentStatus == "Available")">Available</option>
                <option value="Reserved" selected="@(currentStatus == "Reserved")">Reserved</option>
                <option value="Occupied" selected="@(currentStatus == "Occupied")">Occupied</option>
            </select>
        </div>
        <div class="col-md-3 text-end">
            <button type="submit" class="btn btn-dark btn-sm rounded-pill px-3">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-2">Reset</a>
        </div>
    </form>
</div>

<!-- Tables Grid -->
<div class="row g-3">
    @foreach (var t in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6">
            <div class="card h-100 table-card @t.Status.ToLower() p-3 shadow-sm bg-white">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">Table @t.TableNumber</h4>
                        <span class="badge bg-light text-dark border small">@t.Location</span>
                    </div>
                    <status-badge status="@t.Status"></status-badge>
                </div>

                <div class="p-3 my-2 rounded-3 bg-light text-center">
                    <i class="bi bi-people-fill fs-3 text-secondary d-block mb-1"></i>
                    <span class="fw-bold text-dark fs-5">@t.Capacity</span>
                    <span class="text-secondary small d-block">Guests Capacity</span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top mt-auto">
                    <a asp-action="Edit" asp-route-id="@t.TableId" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@t.TableId" method="post" onsubmit="return confirm('Delete this table?');" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
