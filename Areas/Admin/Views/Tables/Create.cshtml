@model Restaurant_Management.Models.Entities.DiningTable
@{
    ViewData["Title"] = "Add Table";
}

<div class="container-fluid py-2" style="max-width: 650px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Tables</a></li>
                    <li class="breadcrumb-item active">New Table</li>
                </ol>
            </nav>
            <h3 class="fw-extrabold text-dark mb-0">Add Dining Table</h3>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">&larr; Back to Tables</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="TableNumber" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="TableNumber" class="form-control" placeholder="e.g. T-13" autofocus />
                <span asp-validation-for="TableNumber" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacity" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="Capacity" class="form-control" type="number" min="1" max="20" />
                <span asp-validation-for="Capacity" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label small fw-semibold text-secondary"></label>
                <select asp-for="Location" class="form-select">
                    <option value="Main Dining">Main Dining</option>
                    <option value="Window View">Window View</option>
                    <option value="Romantic Booth">Romantic Booth</option>
                    <option value="Garden Patio">Garden Patio</option>
                    <option value="VIP Royal Suite">VIP Royal Suite</option>
                    <option value="VIP Banquet Hall">VIP Banquet Hall</option>
                </select>
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label small fw-semibold text-secondary"></label>
                <select asp-for="Status" class="form-select">
                    <option value="Available">Available</option>
                    <option value="Reserved">Reserved</option>
                    <option value="Occupied">Occupied</option>
                </select>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn btn-warning rounded-pill px-5 fw-bold shadow-sm">Save Table</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
