@model Restaurant_Management.Models.Entities.MenuItem
@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Menu" asp-action="Index">Menu</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
        <div class="row g-0">
            <div class="col-lg-6">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80" : Model.ImageUrl)" 
                     alt="@Model.Name" 
                     class="w-100 h-100 object-fit-cover" 
                     style="min-height: 400px; max-height: 520px;" 
                     onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80';" />
            </div>
            <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                            @(Model.Category?.Name ?? "Specialty")
                        </span>
                        @Html.VegNonVegBadge(Model.IsVegetarian)
                    </div>

                    <h1 class="display-6 fw-extrabold text-dark mb-3">@Model.Name</h1>

                    <p class="text-secondary fs-5 mb-4">
                        @Model.Description
                    </p>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-light border">
                                <span class="text-secondary small d-block">Preparation Time</span>
                                <span class="fw-bold text-dark"><i class="bi bi-clock me-1 text-warning"></i> @Model.PreparationTimeMinutes Mins</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3 bg-light border">
                                <span class="text-secondary small d-block">Spice Level</span>
                                <span class="fw-bold text-dark">
                                    @for (int i = 0; i < Model.SpicyLevel; i++)
                                    {
                                        <i class="bi bi-fire text-danger"></i>
                                    }
                                    @(Model.SpicyLevel == 0 ? "Mild / Non-Spicy" : "")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-top d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-secondary small d-block">Price per serving</span>
                        <span class="display-6 fw-extrabold text-dark">@Html.FormatCurrency(Model.Price)</span>
                    </div>

                    <button type="button" 
                            class="btn btn-gold btn-lg rounded-pill px-4 py-3 btn-add-to-cart shadow"
                            data-item-id="@Model.MenuItemId" 
                            data-quantity="1">
                        <i class="bi bi-bag-plus-fill me-2"></i> Add to Order Basket
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
