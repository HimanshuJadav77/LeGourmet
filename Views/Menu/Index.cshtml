@model Restaurant_Management.Models.ViewModels.MenuIndexViewModel
@{
    ViewData["Title"] = "Culinary Menu";
}

<div class="container py-4">
    <!-- Header -->
    <div class="text-center mb-4">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-bold mb-2">
            ARTISANAL KITCHEN
        </span>
        <h1 class="display-5 fw-extrabold text-dark">Our Handcrafted Menu</h1>
        <p class="text-secondary mx-auto" style="max-width: 600px;">
            Order dishes directly to your table or for takeaway. Filter dynamically by category, dietary preferences, or search keywords.
        </p>
    </div>

    <!-- Category Pills / Filter Bar -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-4 pb-2">
        <a href="javascript:void(0)" 
           class="category-chip @(!Model.SelectedCategoryId.HasValue ? "active" : "")" 
           data-category-id="">
            <i class="bi bi-grid-fill"></i> All Dishes
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a href="javascript:void(0)" 
               class="category-chip @(Model.SelectedCategoryId == cat.CategoryId ? "active" : "")" 
               data-category-id="@cat.CategoryId">
                @cat.Name
            </a>
        }
    </div>

    <!-- Live Filter & Search Controls -->
    <div class="p-3 rounded-4 bg-white shadow-sm border mb-4">
        <div class="row g-3 align-items-center">
            <!-- Search Keyword -->
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" 
                           id="menuSearchInput" 
                           class="form-control bg-light border-start-0" 
                           placeholder="Search pasta, pizza, truffle, dessert..." 
                           value="@Model.SearchQuery" />
                </div>
            </div>

            <!-- Veg Only Toggle -->
            <div class="col-md-4 col-6">
                <div class="form-check form-switch d-flex align-items-center gap-2 ps-5">
                    <input class="form-check-input fs-5" type="checkbox" role="switch" id="vegOnlySwitch" @(Model.VegOnly == true ? "checked" : "")>
                    <label class="form-check-label fw-semibold text-success" for="vegOnlySwitch">
                        <i class="bi bi-record-circle-fill text-success me-1"></i> Pure Veg Only
                    </label>
                </div>
            </div>

            <!-- Sort By -->
            <div class="col-md-3 col-6 text-end">
                <select id="menuSortSelect" class="form-select bg-light">
                    <option value="">Sort: Featured First</option>
                    <option value="price_asc">Price: Low to High</option>
                    <option value="price_desc">Price: High to Low</option>
                    <option value="name">Dish Name (A-Z)</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Loading Indicator -->
    <div id="menuItemsLoader" class="text-center py-4 d-none">
        <div class="spinner-border text-warning" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <div class="text-secondary small mt-2">Filtering menu items...</div>
    </div>

    <!-- Dishes Grid Container (Updated via Unobtrusive AJAX) -->
    <div id="menuItemsContainer" class="row">
        @await Html.PartialAsync("_MenuItemListPartial", Model.MenuItems)
    </div>
</div>
