@model Restaurant_Management.Models.ViewModels.OrderReceiptViewModel

<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 invoice-card bg-white">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center border-bottom pb-4 mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="p-2 rounded bg-warning text-dark d-inline-flex"><i class="bi bi-cup-hot-fill"></i></span>
                <span class="fs-4 fw-extrabold text-dark">Le<span class="text-warning">Gourmet</span></span>
            </div>
            <div class="text-secondary small">Fine Dining & Culinary Lounge</div>
            <div class="text-secondary small">GSTIN: 27AABCL1234F1Z8 | FSSAI: 11520023000456</div>
            <div class="text-secondary small">The Heritage Boulevard, Connaught Place, New Delhi</div>
        </div>
        <div class="text-sm-end">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 rounded-pill mb-2">
                <i class="bi bi-patch-check-fill me-1"></i> PAID & CONFIRMED
            </span>
            <div class="fw-bold text-dark fs-5">TAX INVOICE</div>
            <div class="text-muted small">Order #: <span class="text-dark fw-bold">@Model.OrderNumber</span></div>
            <div class="text-muted small">Date: @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
        </div>
    </div>

    <!-- Order & Customer Meta -->
    <div class="row g-3 p-3 rounded-3 bg-light border mb-4">
        <div class="col-sm-6 col-md-3">
            <span class="text-muted small d-block">Customer</span>
            <span class="fw-bold text-dark">@Model.CustomerName</span>
        </div>
        <div class="col-sm-6 col-md-3">
            <span class="text-muted small d-block">Phone Number</span>
            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.CustomerPhone) ? "N/A" : Model.CustomerPhone)</span>
        </div>
        <div class="col-sm-6 col-md-3">
            <span class="text-muted small d-block">Order Type</span>
            <span class="badge bg-dark text-warning">@Model.OrderType</span>
        </div>
        <div class="col-sm-6 col-md-3">
            <span class="text-muted small d-block">Table / Seating</span>
            <span class="fw-bold text-primary">@(string.IsNullOrEmpty(Model.TableNumber) ? "Takeaway Order" : $"Table {Model.TableNumber} ({Model.TableLocation})")</span>
        </div>
    </div>

    <!-- Items Table -->
    <div class="table-responsive mb-4">
        <table class="table table-borderless align-middle mb-0">
            <thead class="border-bottom text-secondary small text-uppercase">
                <tr>
                    <th>Item Description</th>
                    <th class="text-center">Rate</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="border-bottom border-light">
                        <td class="py-3">
                            <div class="d-flex align-items-center gap-2">
                                @Html.VegNonVegBadge(item.IsVegetarian)
                                <span class="fw-semibold text-dark">@item.ItemName</span>
                            </div>
                        </td>
                        <td class="text-center text-secondary py-3">@Html.FormatCurrency(item.UnitPrice)</td>
                        <td class="text-center fw-bold py-3">@item.Quantity</td>
                        <td class="text-end fw-bold text-dark py-3">@Html.FormatCurrency(item.LineTotal)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Calculations -->
    <div class="row justify-content-end mb-4">
        <div class="col-md-6 col-lg-5">
            <div class="p-3 rounded-3 bg-light border">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Subtotal</span>
                    <span class="fw-semibold">@Html.FormatCurrency(Model.SubTotal)</span>
                </div>
                <div class="d-flex justify-content-between mb-1 small text-secondary">
                    <span>CGST (2.5%)</span>
                    <span>@Html.FormatCurrency(Model.CGST)</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small text-secondary border-bottom pb-2">
                    <span>SGST (2.5%)</span>
                    <span>@Html.FormatCurrency(Model.SGST)</span>
                </div>
                <div class="d-flex justify-content-between fs-5 fw-bold text-dark pt-1">
                    <span>Total Amount</span>
                    <span class="text-success">@Html.FormatCurrency(Model.TotalAmount)</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Gateway Settlement Details -->
    @if (Model.Payment != null)
    {
        <div class="p-3 rounded-3 border bg-light-subtle mb-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-shield-check text-success fs-5"></i>
                <span class="fw-bold text-dark">Simulated Payment Gateway Transaction Details</span>
            </div>
            <div class="row g-2 small text-secondary">
                <div class="col-md-4">
                    <span>Txn Reference:</span> <strong class="text-dark">@Model.Payment.TransactionReference</strong>
                </div>
                <div class="col-md-4">
                    <span>Payment Method:</span> <strong class="text-dark">@Model.Payment.PaymentMethod</strong>
                </div>
                <div class="col-md-4">
                    <span>Gateway Status:</span> <span class="badge bg-success">@Model.Payment.Status</span>
                </div>
                <div class="col-md-4">
                    <span>Auth Approval Code:</span> <strong class="text-dark">@(Model.Payment.GatewayAuthCode ?? "AUTH-OK")</strong>
                </div>
                <div class="col-md-4">
                    <span>Paid On:</span> <strong class="text-dark">@Model.Payment.PaymentDate.ToString("dd MMM yyyy, hh:mm:ss tt")</strong>
                </div>
                <div class="col-md-4">
                    <span>Instrument:</span> <strong class="text-dark">@(Model.Payment.CardLastFour != null ? $"Card Ending ****{Model.Payment.CardLastFour}" : (Model.Payment.UpiId ?? "Digital Wallet"))</strong>
                </div>
            </div>
        </div>
    }

    <!-- Footer Action Buttons -->
    <div class="d-flex justify-content-between align-items-center no-print pt-3 border-top">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-house me-1"></i> Return Home
        </a>
        <div class="d-flex gap-2">
            <a asp-controller="Order" asp-action="Track" asp-route-orderNumber="@Model.OrderNumber" class="btn btn-dark rounded-pill px-4">
                <i class="bi bi-geo-alt me-1"></i> Track Live Status
            </a>
            <button type="button" class="btn btn-gold rounded-pill px-4" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i> Print Tax Invoice
            </button>
        </div>
    </div>
</div>
