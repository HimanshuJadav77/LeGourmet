@model Restaurant_Management.Models.Entities.MenuItem

<div class="card h-100 card-hover-zoom shadow-sm border-0">
    <div class="dish-img-container position-relative">
        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80" : Model.ImageUrl)" 
             alt="@Model.Name" 
             class="dish-img" 
             loading="lazy" 
             onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=800&q=80';" />
        
        <div class="position-absolute top-0 start-0 m-3">
            @Html.VegNonVegBadge(Model.IsVegetarian)
        </div>

        @if (Model.SpicyLevel > 0)
        {
            <div class="position-absolute top-0 end-0 m-3">
                <span class="badge bg-danger shadow-sm" title="Spice Level: @Model.SpicyLevel/3">
                    @for (int i = 0; i < Model.SpicyLevel; i++)
                    {
                        <i class="bi bi-fire text-warning"></i>
                    }
                </span>
            </div>
        }

        <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-gradient-dark text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);">
            <small class="text-white-50"><i class="bi bi-clock me-1"></i> @Model.PreparationTimeMinutes mins</small>
            <span class="badge bg-black bg-opacity-75 text-warning border border-warning-subtle">
                @(Model.Category?.Name ?? "Specialty")
            </span>
        </div>
    </div>

    <div class="card-body d-flex flex-column p-3">
        <h5 class="card-title fw-bold mb-1 text-dark">@Model.Name</h5>
        <p class="card-text text-secondary small flex-grow-1 mb-3" style="min-height: 42px;">
            @(string.IsNullOrEmpty(Model.Description) ? "Chef's gourmet creation prepared with fresh seasonal ingredients." : Model.Description)
        </p>

        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
            <div>
                <span class="text-secondary fs-8 d-block">Price</span>
                <span class="fs-5 fw-bold text-dark">@Html.FormatCurrency(Model.Price)</span>
            </div>

            <button type="button" 
                    class="btn btn-gold rounded-pill px-3 py-2 btn-add-to-cart d-flex align-items-center gap-1"
                    data-item-id="@Model.MenuItemId"
                    data-quantity="1">
                <i class="bi bi-plus-lg fw-bold"></i> Add
            </button>
        </div>
    </div>
</div>
