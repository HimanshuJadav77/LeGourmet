@model Restaurant_Management.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Your Order Basket";
    var availableTables = ViewBag.AvailableTables as List<Restaurant_Management.Models.Entities.DiningTable> ?? new List<Restaurant_Management.Models.Entities.DiningTable>();
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-extrabold text-dark mb-1">Your Dining Basket</h1>
            <p class="text-secondary small mb-0">Persistent session-state order cart</p>
        </div>

        @if (Model.Items.Any())
        {
            <form asp-controller="Cart" asp-action="Clear" method="post">
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Clear entire cart?');">
                    <i class="bi bi-trash3 me-1"></i> Clear Basket
                </button>
            </form>
        }
    </div>

    @if (!Model.Items.Any())
    {
        <div class="p-5 text-center bg-white rounded-4 shadow-sm border my-4">
            <div class="p-4 rounded-circle bg-light d-inline-flex mb-3 text-secondary">
                <i class="bi bi-bag-x fs-1"></i>
            </div>
            <h3 class="fw-bold">Your order basket is empty</h3>
            <p class="text-secondary mb-4">Explore our delicious artisan dishes and add your favorites to get started!</p>
            <a asp-controller="Menu" asp-action="Index" class="btn btn-gold btn-lg rounded-pill px-5">
                <i class="bi bi-journal-richtext me-2"></i> Browse Food Menu
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items List -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4">
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <thead class="border-bottom text-secondary small text-uppercase">
                                <tr>
                                    <th>Dish</th>
                                    <th class="text-center">Price</th>
                                    <th class="text-center" style="width: 140px;">Quantity</th>
                                    <th class="text-end">Total</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr id="cartRow-@item.MenuItemId" class="border-bottom">
                                        <td class="py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=150&q=80" : item.ImageUrl)" 
                                                     alt="@item.Name" 
                                                     class="rounded-3 object-fit-cover" 
                                                     style="width: 60px; height: 60px;" 
                                                     onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=150&q=80';" />
                                                <div>
                                                    <h6 class="fw-bold mb-1 text-dark">@item.Name</h6>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @Html.VegNonVegBadge(item.IsVegetarian)
                                                        @if (!string.IsNullOrEmpty(item.Notes))
                                                        {
                                                            <small class="text-secondary fst-italic">Note: @item.Notes</small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-semibold text-secondary py-3">
                                            @Html.FormatCurrency(item.Price)
                                        </td>
                                        <td class="py-3">
                                            <div class="input-group input-group-sm justify-content-center">
                                                <button class="btn btn-outline-secondary" type="button" 
                                                        onclick="RestaurantApp.updateCartQuantity(@item.MenuItemId, @item.Quantity - 1)">
                                                    <i class="bi bi-dash"></i>
                                                </button>
                                                <input type="text" id="itemQtyInput-@item.MenuItemId" 
                                                       class="form-control text-center bg-light fw-bold" 
                                                       value="@item.Quantity" readonly style="max-width: 48px;" />
                                                <button class="btn btn-outline-secondary" type="button" 
                                                        onclick="RestaurantApp.updateCartQuantity(@item.MenuItemId, @item.Quantity + 1)">
                                                    <i class="bi bi-plus"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold text-dark py-3" id="itemLineTotal-@item.MenuItemId">
                                            @Html.FormatCurrency(item.LineTotal)
                                        </td>
                                        <td class="text-end py-3">
                                            <button type="button" class="btn btn-link text-danger p-0" 
                                                    onclick="RestaurantApp.removeCartItem(@item.MenuItemId)" 
                                                    title="Remove dish">
                                                <i class="bi bi-trash3 fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="pt-3 d-flex justify-content-between align-items-center">
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-outline-dark rounded-pill btn-sm px-3">
                            <i class="bi bi-arrow-left me-1"></i> Add More Dishes
                        </a>
                        <span class="text-secondary small">Session Persistent Cart</span>
                    </div>
                </div>
            </div>

            <!-- Order Summary & Checkout Card -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3 text-dark">Order Billing Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Dishes Subtotal</span>
                        <span class="fw-semibold text-dark" id="cartSubTotal">@Html.FormatCurrency(Model.SubTotal)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>GST Tax (5% Standard)</span>
                        <span id="cartTaxAmount">@Html.FormatCurrency(Model.TaxAmount)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 small text-muted">
                        <span>Service Fee / Cover</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold text-dark">Estimated Grand Total</span>
                        <span class="fs-4 fw-extrabold text-success" id="cartGrandTotal">@Html.FormatCurrency(Model.GrandTotal)</span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-gold btn-lg rounded-pill w-100 py-3 shadow">
                        Proceed to Checkout <i class="bi bi-arrow-right ms-1"></i>
                    </a>

                    <div class="mt-3 text-center text-secondary small">
                        <i class="bi bi-shield-check text-success me-1"></i> 100% Secure Payment Simulation
                    </div>
                </div>
            </div>
        </div>
    }
</div>
