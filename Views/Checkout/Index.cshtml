@model Restaurant_Management.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout & Bill Settlement";
}

<div class="container py-5">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Basket</a></li>
                <li class="breadcrumb-item active">Checkout</li>
            </ol>
        </nav>
        <h1 class="fw-extrabold text-dark mb-0">Checkout & Bill Settlement</h1>
        <p class="text-secondary small">Payment Gateway Simulation with Instant GST Tax Invoice Generation</p>
    </div>

    <form asp-controller="Checkout" asp-action="Process" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left: Customer Details & Dining Mode -->
            <div class="col-lg-7">
                <!-- Customer Details Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-person-fill text-warning"></i> Customer Information
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CustomerName" class="form-control" placeholder="e.g. Rahul Sharma" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerPhone" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CustomerPhone" class="form-control" placeholder="e.g. +91 98123 45678" />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="CustomerEmail" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="CustomerEmail" class="form-control" placeholder="e.g. rahul@example.com" />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Dining Option & Table Assignment Card -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-shop text-warning"></i> Dining Preference
                    </h5>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="OrderType" class="form-label small fw-semibold text-secondary"></label>
                            <select asp-for="OrderType" class="form-select" id="orderTypeSelect">
                                <option value="Dine-In">Dine-In (At Restaurant)</option>
                                <option value="Takeaway">Takeaway (Self-Pickup)</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="tableSelectionGroup">
                            <label asp-for="TableId" class="form-label small fw-semibold text-secondary">Assign Table</label>
                            <select asp-for="TableId" class="form-select">
                                <option value="">-- Choose Dining Table --</option>
                                @foreach (var t in Model.AvailableTables)
                                {
                                    <option value="@t.TableId">Table @t.TableNumber (@t.Location - Capacity: @t.Capacity)</option>
                                }
                            </select>
                            <span asp-validation-for="TableId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="OrderNotes" class="form-label small fw-semibold text-secondary"></label>
                            <textarea asp-for="OrderNotes" class="form-control" rows="2" placeholder="Special cooking instructions, allergies, less spicy, extra napkins..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Payment Gateway Simulation Section -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-credit-card-2-front-fill text-warning"></i> Simulated Payment Gateway
                        </h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                            <i class="bi bi-shield-lock-fill me-1"></i> Sandbox Active
                        </span>
                    </div>

                    <!-- Payment Method Tabs -->
                    <ul class="nav nav-pills mb-3 gap-2" id="paymentMethodPills" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill px-3 py-2 fw-semibold" id="card-tab" data-bs-toggle="pill" data-bs-target="#card-pane" type="button" role="tab" onclick="$('#PaymentMethod').val('Credit/Debit Card')">
                                <i class="bi bi-credit-card me-1"></i> Credit / Debit Card
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-3 py-2 fw-semibold" id="upi-tab" data-bs-toggle="pill" data-bs-target="#upi-pane" type="button" role="tab" onclick="$('#PaymentMethod').val('UPI Payment')">
                                <i class="bi bi-qr-code-scan me-1"></i> Instant UPI
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link rounded-pill px-3 py-2 fw-semibold" id="netbank-tab" data-bs-toggle="pill" data-bs-target="#netbank-pane" type="button" role="tab" onclick="$('#PaymentMethod').val('NetBanking')">
                                <i class="bi bi-bank me-1"></i> Net Banking
                            </button>
                        </li>
                    </ul>

                    <input type="hidden" asp-for="PaymentMethod" id="PaymentMethod" value="Credit/Debit Card" />

                    <!-- Tab Panes -->
                    <div class="tab-content p-3 rounded-3 bg-light border" id="paymentTabContent">
                        <!-- Card Tab -->
                        <div class="tab-pane fade show active" id="card-pane" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label small fw-semibold text-secondary">Cardholder Name</label>
                                    <input asp-for="CardholderName" class="form-control bg-white" placeholder="Name as printed on card" value="Demo Cardholder" />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label small fw-semibold text-secondary">Card Number</label>
                                    <div class="input-group">
                                        <input asp-for="CardNumber" class="form-control bg-white" placeholder="4242 •••• •••• 4242" value="4242424242424242" />
                                        <span class="input-group-text bg-white"><i class="bi bi-credit-card text-muted"></i></span>
                                    </div>
                                    <span asp-validation-for="CardNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-3 col-6">
                                    <label class="form-label small fw-semibold text-secondary">Expiry Date</label>
                                    <input asp-for="CardExpiry" class="form-control bg-white text-center" placeholder="12/28" value="12/28" />
                                    <span asp-validation-for="CardExpiry" class="text-danger small"></span>
                                </div>
                                <div class="col-md-2 col-6">
                                    <label class="form-label small fw-semibold text-secondary">CVV</label>
                                    <input asp-for="CardCvv" class="form-control bg-white text-center" placeholder="123" value="123" maxlength="4" />
                                    <span asp-validation-for="CardCvv" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- UPI Tab -->
                        <div class="tab-pane fade" id="upi-pane" role="tabpanel">
                            <div class="row align-items-center g-3">
                                <div class="col-md-7">
                                    <label class="form-label small fw-semibold text-secondary">Virtual Payment Address (VPA) / UPI ID</label>
                                    <input asp-for="UpiId" class="form-control bg-white" placeholder="username@okhdfcbank" value="demo@upi" />
                                    <span asp-validation-for="UpiId" class="text-danger small"></span>
                                    <div class="text-muted small mt-2">Supports Google Pay, PhonePe, Paytm, BHIM</div>
                                </div>
                                <div class="col-md-5 text-center border-start-md">
                                    <div class="p-2 rounded bg-white d-inline-block shadow-sm">
                                        <i class="bi bi-qr-code fs-1 text-dark"></i>
                                    </div>
                                    <div class="small text-secondary mt-1">Scan QR to Pay</div>
                                </div>
                            </div>
                        </div>

                        <!-- NetBanking Tab -->
                        <div class="tab-pane fade" id="netbank-pane" role="tabpanel">
                            <label class="form-label small fw-semibold text-secondary">Select Bank</label>
                            <select asp-for="BankName" class="form-select bg-white">
                                <option value="HDFC Bank">HDFC Bank</option>
                                <option value="State Bank of India">State Bank of India</option>
                                <option value="ICICI Bank">ICICI Bank</option>
                                <option value="Axis Bank">Axis Bank</option>
                                <option value="Punjab National Bank">Punjab National Bank</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary Breakdown -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3 text-dark">Order Items (@Model.Cart.TotalItems)</h5>

                    <div class="overflow-auto mb-3" style="max-height: 240px;">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-light text-dark border fw-bold">@item.Quantity ×</span>
                                    <div>
                                        <div class="fw-semibold text-dark small">@item.Name</div>
                                        <div class="text-secondary fs-8">@Html.FormatCurrency(item.Price) each</div>
                                    </div>
                                </div>
                                <span class="fw-bold text-dark small">@Html.FormatCurrency(item.LineTotal)</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>Items Subtotal</span>
                        <span class="fw-semibold text-dark">@Html.FormatCurrency(Model.Cart.SubTotal)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>CGST (2.5%)</span>
                        <span>@Html.FormatCurrency(Math.Round(Model.Cart.SubTotal * 0.025m, 2))</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 small text-secondary">
                        <span>SGST (2.5%)</span>
                        <span>@Html.FormatCurrency(Math.Round(Model.Cart.SubTotal * 0.025m, 2))</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fs-5 fw-bold text-dark">Total Payable</span>
                        <span class="fs-4 fw-extrabold text-success">@Html.FormatCurrency(Model.Cart.GrandTotal)</span>
                    </div>

                    <button type="submit" class="btn btn-gold btn-lg rounded-pill w-100 py-3 shadow fw-bold" id="payButton">
                        <i class="bi bi-lock-fill me-1"></i> Pay & Generate Invoice (@Html.FormatCurrency(Model.Cart.GrandTotal))
                    </button>

                    <div class="text-center text-muted small mt-3">
                        By placing this order you simulate live transaction settlement and receipt generation.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $('#orderTypeSelect').on('change', function () {
            if ($(this).val() === 'Takeaway') {
                $('#tableSelectionGroup').hide();
            } else {
                $('#tableSelectionGroup').show();
            }
        });
    </script>
}
