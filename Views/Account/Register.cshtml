@model Restaurant_Management.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="p-3 rounded-circle bg-light d-inline-flex mb-2">
                        <i class="bi bi-person-plus-fill fs-3 text-warning"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark mb-1">Create Account</h3>
                    <p class="text-secondary small">Join Le Gourmet for VIP reservations and fast checkout</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Rahul Sharma" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+91 98123 45678" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="Password" class="form-control" placeholder="At least 6 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-gold btn-lg rounded-pill w-100 py-3 fw-bold shadow">
                        Register Account
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-secondary">
                    Already registered? 
                    <a asp-action="Login" class="text-dark fw-bold text-decoration-none">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
