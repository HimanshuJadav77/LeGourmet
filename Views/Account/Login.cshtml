@model Restaurant_Management.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <!-- 1-Click Fast Demo Box for Viva/Presentation -->
            <div class="card border-warning shadow-sm rounded-4 mb-4 bg-warning-subtle text-dark p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-stars text-warning fs-4"></i>
                    <h6 class="fw-bold mb-0">College Showcase 1-Click Demo Sign In</h6>
                </div>
                <p class="small text-secondary mb-3">
                    Click either button below to instantly authenticate without typing credentials:
                </p>
                <div class="d-flex gap-2">
                    <a asp-action="QuickLogin" asp-route-role="admin" class="btn btn-dark btn-sm flex-fill fw-bold rounded-pill">
                        <i class="bi bi-shield-lock me-1"></i> Demo Admin
                    </a>
                    <a asp-action="QuickLogin" asp-route-role="customer" class="btn btn-outline-dark btn-sm flex-fill fw-bold rounded-pill">
                        <i class="bi bi-person me-1"></i> Demo Customer
                    </a>
                </div>
            </div>

            <!-- Standard Login Form -->
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <div class="p-3 rounded-circle bg-light d-inline-flex mb-2">
                        <i class="bi bi-person-fill fs-3 text-warning"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark mb-1">Welcome Back</h3>
                    <p class="text-secondary small">Sign in to manage your dining reservations and orders</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
                        <label class="form-check-label small text-secondary" asp-for="RememberMe"></label>
                    </div>

                    <button type="submit" class="btn btn-gold btn-lg rounded-pill w-100 py-3 fw-bold shadow">
                        Sign In
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top small text-secondary">
                    Don't have an account yet? 
                    <a asp-action="Register" class="text-dark fw-bold text-decoration-none">Create an Account</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
